# ==========================================
# Food Rescue Intelligence (FRI) - Environment Variables
# ==========================================

# Server Configuration
PORT=5000
NODE_ENV=development # change to 'production' in production

# Client CORS URL (comma-separated for multiple origins)
CLIENT_URL=http://localhost:5173,http://localhost:3000

# MongoDB Database Connection URI
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/food_rescue_intelligence?retryWrites=true&w=majority

# JWT Session Authentication Secret (use random 64-character hex in production)
JWT_SECRET=super_secret_production_jwt_key_min_32_characters_long

# Google OAuth 2.0 Client ID (from Google Cloud Console)
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com

# Email Service Configuration (Nodemailer SMTP)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-google-app-password

# SMS Gateway (Fast2SMS / Twilio - Optional fallback)
SMS_API_KEY=your_sms_gateway_api_key
